{
  "name": "rakuten-travel-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for all seven Rakuten Travel Web Service APIs",
  "type": "module",
  "bin": {
    "rakuten-travel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx scripts/live-smoke.ts",
    "check:spec": "node --import tsx scripts/check-spec.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
